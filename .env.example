# Server
SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=todo_chat_app
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=1800

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092

# Auth0
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://todo-chat-app-api
WEBHOOK_SECRET=replace-with-strong-webhook-secret

# Local JWT (email/password auth)
JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAY=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000
