# Server
SERVER_PORT=8080
# GIN_MODE: release (default, prod) | debug (local) | test
GIN_MODE=release

# Reverse proxy / TLS (Caddy)
# Real domain -> automatic Let's Encrypt HTTPS. Use "localhost" for local dev.
DOMAIN=your-domain.com

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=todo_chat_app
DB_SSLMODE=disable
POSTGRES_HOST_PORT=5432
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=1800

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_HOST_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Auth0 (DEPRECATED — being removed in T80). Leave DOMAIN & AUDIENCE empty to
# disable the Auth0 verification path; the app then trusts only local tokens.
# Setting only one of the two is a misconfiguration and fails startup.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
WEBHOOK_SECRET=replace-with-strong-webhook-secret

# Local JWT (email/password auth) — JWT_SECRET is required to boot.
JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAY=7

# Email
# Production must use smtp. "log" prints auth/invitation tokens to app logs and
# is acceptable only for local/dev data.
EMAIL_TRANSPORT=smtp
APP_BASE_URL=https://api.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=todo-chat-app
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@example.com

# CORS
ALLOWED_ORIGINS=https://app.example.com
